{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学习中枢",
  "mainBinaryName": "learning-hub",
  "version": "0.1.0",
  "identifier": "com.learninghub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "学习中枢",
        "width": 1480,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:; frame-src https: http: data: blob:; worker-src 'self' blob:; media-src 'self' data: blob: https:",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 旅行者0618",
    "category": "Education",
    "shortDescription": "个人 AI 学习助手",
    "longDescription": "学习中枢：把预习、学习、复习、Anki 卡片与日程规划串成一条线的个人 AI 学习助手。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
